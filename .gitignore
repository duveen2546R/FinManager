# ---------------------------------------------------------------------------
# FinManager — root .gitignore
# React Native (Expo) frontend + Python/Flask backend
# ---------------------------------------------------------------------------

# --- Node / JavaScript ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Expo ---
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# --- Native projects (generated by `expo prebuild`; reproduced via app.json + plugins) ---
/ios/
/android/

# --- Native build / tooling artifacts ---
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.hprof
.gradle/
.kotlin/

# --- Metro ---
.metro-health-check*

# --- Python backend ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Editors / IDEs ---
.idea/
.vscode/*
!.vscode/settings.json
*.iml
*.ipr
*.iws
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
