# ---------------------------------------------------------------------------
# FinManager — root .gitignore
# Flutter frontend (finmanager_app/) + Python/Flask backend
#
# The Flutter app has its own finmanager_app/.gitignore that covers Dart/Flutter
# build artifacts (build/, .dart_tool/, Pods, etc.); this file covers the
# backend, shared tooling, and secrets.
# ---------------------------------------------------------------------------

# --- Flutter / Dart (belt-and-suspenders; also handled in finmanager_app/.gitignore) ---
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework/
**/ios/Flutter/Flutter.podspec
**/android/.gradle/
**/android/local.properties
**/android/key.properties
*.symbols
*.map.json

# --- Python backend ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Native signing / provisioning artifacts ---
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.hprof

# --- Editors / IDEs ---
.idea/
.vscode/*
!.vscode/settings.json
*.iml
*.ipr
*.iws
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log

# --- Docs / marketing assets ---
screenshots/
