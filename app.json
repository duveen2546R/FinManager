{
  "expo": {
    "name": "FinManager",
    "slug": "finmanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "finmanager",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finmanager.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FinManager uses the microphone so you can talk to the AI agent.",
        "NSSpeechRecognitionUsageDescription": "FinManager uses speech recognition to transcribe your voice for the AI agent.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.finmanager.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FinManager uses the microphone so you can talk to the AI agent.",
          "speechRecognitionPermission": "FinManager uses speech recognition to transcribe your voice for the AI agent."
        }
      ],
      "expo-font",
      "expo-asset",
      "./plugins/withFmtConstevalFix",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
